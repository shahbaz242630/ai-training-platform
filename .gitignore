# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# keys and certificates - never in this public repository (audit s104 SUP-10).
# certs.local/ is named outright, not left to the *.local pattern below.
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
certs.local/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - real values never committed; the template is documentation
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch
*.local

# Internal working documents - deliberately NOT published.
# This repository is public; these carry pricing strategy, capacity and revenue
# analysis, licensing status and commercial boundaries. They live on disk only.
AI_Training_Platform_BRD.md
AI_Training_Platform_PRD.md
HANDOFF.md
CLAUDE.md
AGENTS.md

# DAST scan output
zap-out/
zap-report.*
