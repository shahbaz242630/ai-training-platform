# Copy to .env.local and fill in. NEVER commit .env.local.
# Only NEXT_PUBLIC_* values reach the browser - never put a secret behind that prefix.

# --- Application ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# Which deployment this is: development | staging | production
# ONLY "production" allows the site to be indexed, and only then if the real
# company identity is filled in. Staging must stay non-production so the
# throwaway host domain is never indexed against the real one.
NEXT_PUBLIC_SITE_ENV="development"

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=""

# Publishable (formerly "anon") key. Public BY DESIGN: row level security is on
# for every table with no policies, so this key can read and write nothing.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Direct Postgres connection, including the project password. Server only.
# This is how migrations are applied and how the application reads and writes.
DATABASE_URL=""

# Only needed if something ever uses the Supabase SDK rather than SQL.
# Bypasses row level security entirely - server only, never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Stripe (test mode until the trade licence is issued) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Microsoft Graph (calendar + Teams) ---
# Dev uses the existing GoDaddy-resold tenant; production will use a new tenant.
# Keep every value here so switching tenants is config, not code.
MS_TENANT_ID=""
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""
MS_CALENDAR_USER_ID=""

# --- Email ---
RESEND_API_KEY=""
EMAIL_FROM=""

# --- Scheduled jobs (Supabase Cron calls this endpoint) ---
CRON_SECRET=""

# --- Monitoring ---
SENTRY_DSN=""
